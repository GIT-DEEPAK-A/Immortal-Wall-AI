# Immortal Wall AI - Environment Configuration
# Copy this file to .env and fill in your actual values

# Flask/FastAPI Configuration
FLASK_ENV=development
FLASK_APP=backend.app
DEBUG=False

# Database Configuration
DATABASE_URL=sqlite:///./data/immortal_wall.db
DB_PATH=./data/immortal_wall.db

# SMTP Email Configuration (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SENDER=deepakananthan4@gmail.com
SMTP_APP_PASSWORD=password

# OTP Configuration
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=3

# Session Configuration
SESSION_SECRET_KEY=your_secret_key_change_this_in_production

# Server Configuration
HOST=0.0.0.0
PORT=8000
UVICORN_WORKERS=4

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:5179,http://localhost:3000,http://127.0.0.1:3000

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/backend.log

# Security
SECRET_KEY=change_this_in_production
ALGORITHM=HS256

# Optional: API Keys for threat intelligence
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
