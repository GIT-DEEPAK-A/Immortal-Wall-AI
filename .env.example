# Immortal Wall AI — Environment Configuration
# Copy this file to .env and fill in your actual values.

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/immortal_wall.db
DB_PATH=./data/immortal_wall.db

# ── SMTP Email (optional — only needed if you add email alerting) ─────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SENDER=you@gmail.com
SMTP_APP_PASSWORD=your_gmail_app_password_here

# ── Server ────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
UVICORN_WORKERS=4

# ── Security ──────────────────────────────────────────────────────────────
# Change this in production — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SYSTEM_PASSKEY=123456   # Change this in production
JWT_SECRET_KEY=generate-a-strong-random-key-here
SESSION_SECRET_KEY=your_secret_key_change_this_in_production
ALGORITHM=HS256

# ── Rate limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true

# ── CORS ──────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:3000,http://127.0.0.1:3000

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./logs/backend.log

# ── Optional: threat intelligence API keys ────────────────────────────────
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
